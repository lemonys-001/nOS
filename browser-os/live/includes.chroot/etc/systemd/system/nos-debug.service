[Unit]
Description=nOS boot diagnostics to serial console
After=multi-user.target

[Service]
Type=oneshot
# dump session state to /dev/ttyS0 every 60s for 9 rounds, so CI can see
# whether the browser session actually started
ExecStart=/bin/sh -c 'i=1; while [ $i -le 9 ]; do sleep 60; { echo "=== nos-debug round $i ==="; systemctl is-active nos-session; journalctl -u nos-session --no-pager | tail -12; ps ax | grep -E "Xorg|chromium|openbox|xinit" | grep -v grep; echo "--- xsession log:"; tail -30 /home/nos/nos-session.log 2>/dev/null; echo "--- Xorg log:"; tail -40 /var/log/Xorg.0.log 2>/dev/null || tail -40 /home/nos/.local/share/xorg/Xorg.0.log 2>/dev/null || echo "(no Xorg log)"; echo "--- xorg root rights:"; ls -la /usr/bin/X /usr/bin/Xorg /usr/lib/xorg/Xorg* 2>/dev/null; cat /etc/X11/Xwrapper.config 2>/dev/null; echo "--- sessions/bus:"; loginctl list-sessions --no-legend 2>/dev/null; ls -la /run/dbus/system_bus_socket 2>/dev/null || echo "(no system bus socket)"; echo "--- /dev/dri:"; ls -la /dev/dri 2>/dev/null; dmesg | grep -iE "drm|virtio.?gpu" | tail -8; } >> /dev/ttyS0 2>&1; i=$((i+1)); done'

[Install]
WantedBy=multi-user.target
