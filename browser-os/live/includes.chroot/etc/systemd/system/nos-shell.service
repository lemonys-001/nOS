[Unit]
Description=nOS serial console shell (root, no password - live system rescue)
After=multi-user.target
Conflicts=serial-getty@ttyS0.service

[Service]
Type=simple
ExecStart=/bin/sh -c 'exec /sbin/agetty --autologin root --noclear 115200 ttyS0 vt100'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
