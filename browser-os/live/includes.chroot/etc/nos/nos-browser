#!/bin/sh
# Launch Chromium fullscreen. If it ever exits, nodm restarts the session.
CHROMIUM_FLAGS="--kiosk \
--no-first-run \
--no-default-browser-check \
--disable-session-crashed-bubble \
--disable-infobars \
--disable-features=Translate,MediaRouter \
--password-store=basic \
--user-data-dir=/home/nos/.config/chromium \
--homepage=http://127.0.0.1:8080/lemonos/index.html \
http://127.0.0.1:8080/lemonos/index.html"

echo NOS_BROWSER_START > /dev/ttyS0 2>/dev/null || true

chromium $CHROMIUM_FLAGS
rc=$?
echo NOS_BROWSER_EXIT=$rc > /dev/ttyS0 2>/dev/null || true
sleep 2
exit $rc
